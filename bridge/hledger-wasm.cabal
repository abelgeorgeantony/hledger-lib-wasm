cabal-version: 2.4
name: hledger-wasm
version: 0.1
build-type: Simple

executable hledger-wasm
  main-is: Main.hs
  build-depends:
      base
    , hledger-lib ==1.52.1
    , aeson
    , bytestring
    , mtl
    , text
    , time
    , ghc-experimental
    , containers
  default-language: Haskell2010
  ghc-options:
    -no-hs-main
    -optl-mexec-model=reactor
    -optl-Wl,--export=parseJournal,--export=freeJournal,--export=runReport,,--export=parseCsv,--export=balanceTransaction,--export=getJournalJSON