packages:
  bridge
  stubs/terminal-size
  vendor/hledger/hledger-lib

with-compiler: wasm32-wasi-ghc

constraints:
  terminal-size ==0.3.4

allow-newer:
  terminal-size:base,
  *:base,
  *:ghc-bignum,
  *:ghc-prim,
  *:ghc-internal,
  *:template-haskell,
  *:ghc-boot-th,
  *:ghc-boot,
  *:deepseq,
  *:array,
  *:bytestring,
  *:containers,
  *:directory,
  *:filepath,
  *:process,
  *:time,
  *:unix,
  *:pretty,
  *:stm,
  *:parsec,
  *:transformers,
  *:exceptions